# Cloudflare R2 Object Storage Configuration
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (Create token with Object Read & Write permissions)
VITE_R2_ACCOUNT_ID=your_cloudflare_account_id
VITE_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
VITE_R2_BUCKET_NAME=mypdfnotes
# Optional: Cloudflare R2 Public Development URL or Custom Domain (e.g., https://pub-xxxx.r2.dev)
VITE_R2_PUBLIC_URL=

# GitHub Token (Optional alternative)
VITE_GITHUB_TOKEN=
